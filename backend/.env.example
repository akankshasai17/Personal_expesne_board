# ==============================================================================
# SpendWise Backend Environment Configuration Example
# Duplicate this file as .env and replace placeholders with your actual secrets.
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://akanksha:<db_password>@cluster0.q8b7exq.mongodb.net/spendwise?retryWrites=true&w=majority

# For Local MongoDB (Alternative):
# MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# JWT Secret Key for token signing and verification
JWT_SECRET=spendwise_jwt_secret_key_change_in_production_2026

# JWT Token Expiry (e.g. 7d, 24h)
JWT_EXPIRE=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_ORIGIN=http://localhost:3000
